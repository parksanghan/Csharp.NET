<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <appSettings>

    <!-- YHU 20160506 해당내용 추가 -->
    <!-- CucsID Ssttings Start =====>> -->
    <!-- 육/공군 설정 = 1: 육군, 2: 공군 -->
    <add key="PTS_PPC_ARMY" value="2"/>
    <!-- 부대 설정 = 1: B6, 2: MUAV -->
    <add key="PTS_PPC_CORPS" value="2"/>
    <!-- 장비 설정 = 1: 고정형#1, 2: 고정형#2, 11: 이동형#1, 12: 이동형#2 -->
    <add key="PTS_PPC_EQUIPS" value="11"/>
    <!-- PPC VSM 설정 = 21: PPC CUCS ID, 22: SPC CUCS ID, 23: SOC CUCS ID-->
    <add key="PTS_PPC_VSM" value="21"/>

    <!-- 화면 최대화 최소화 설정 TRUE : 최대, FALSE : 최소-->
    <!--20170302 jamy91 add-->
    <add key="WINFORM_CONTROL" value ="FALSE"/>

    <!-- PTS NUMBER 설정 = 1: PTS #1, 2: PTS #2, 3: PTS #3, 4: PTS #4-->
    <add key="PTS_NUMBER" value="2"/>

    <add key="PTS_VERSION" value="F01A"/>
    
    <!-- NETWORK SETTINGS -->
    <add key="TO_AVS_IP1" value="10.20.11.128"/>
    <add key="TO_AVS_PORT1" value="23802"/>

    <add key="TO_AVS_IP2" value="10.20.111.128"/>
    <add key="TO_AVS_PORT2" value="33802"/>

    <add key="TO_DLS_IP1" value="10.20.11.129"/>
    <add key="TO_DLS_PORT1" value="23803"/>

    <add key="TO_DLS_IP2" value="10.20.111.220"/>
    <add key="TO_DLS_PORT2" value="33803"/>

    <!--<add key="TO_IME_IP" value="127.0.0.1"/>-->
    <add key="TO_IME_IP" value="10.20.11.129"/>
    <add key="TO_IME_PORT" value="59005"/>

    <!--<add key="TO_OCS_IP" value="10.20.11.97"/>-->
    <add key="TO_OCS_IP" value="10.20.11.151"/>
    <add key="TO_OCS_PORT" value="23801"/>
    <add key="TO_OCS_SEQUENCE_PORT" value="23904"/>
    <add key="TO_OCS_PTS_INFO_PORT" value="23905"/>
    <!--<add key="TO_OCS_PORT" value="33801"/>  -->
    <!--ocs로 전송 막기 위해 없는 포트 설정. 2만대 포트가 정상포트-->
    <!-- <add key="TO_OCS_SEQUENCE_PORT" value="33904"/>
    <add key="TO_OCS_PTS_INFO_PORT" value="33905"/>-->

    <!-- YHU 20160506 해당내용 추가 -->
    <!-- PTS 전원 인가를 위한 PTS 1,2,3,4 IP 설정 -->
    <add key="TO_PTS_TS_IP1" value="10.20.11.93"/>
    <add key="TO_PTS_TS_IP2" value="10.20.11.94"/>
    <add key="TO_PTS_TS_IP3" value="10.20.11.95"/>
    <add key="TO_PTS_TS_IP4" value="10.20.11.96"/>

    <!-- YHU 20170316 PTS IG -->
    <add key="TO_PTS_IG" value="10.20.11.95"/>
    <add key="TO_PTS_IG_PORT" value="23811"/>
    <!-- YHU 20170329 해당내용 추가 - PTS STREAMING -->
    <add key="TO_PTS_STREAMING_PORT" value="11000"/>

    <add key="FROM_OTHER_DEV_PORT" value="23804"/>
    <add key="FROM_IME_PORT"  value="59006"/>
    <add key="FROM_AVS_PORT1" value="33554"/>
    <add key="FROM_AVS_PORT2" value="33555"/>

    <add key="TO_STREAMING_IP" value="10.20.11.95"/>
    <add key="TO_STREAMING_PORT" value="11000"/>

    <!-- YHU 20160506 해당내용 삭제 -->
    <!--<add key="PPC_CUCS_ID" value="303174912"/>-->
    <!--1:303174912, 2:303175168, 3:303175424, 4:303175680-->
    <!-- WINDOW SETTINGS -->
    <add key="WINDOWOFF" value="false"/>
    <!--<add key="DTED" value="D:Data\DTED\DTED"/>-->
    <add key="DTED" value="E:\Shinil\Data\DTED\DTED"/>
    <add key="VISIBLEWINDOWURI" value="Windows/MainWindow.xaml"/>
    <add key="INVISIBLEWINDOWURI" value="Windows/InvisibleTestBedUiWindow.xaml"/>

    <!-- ICD XML PATH -->
    <add key="PTS_CAD" value="C:\temp\M.Settings\MGDT_CAD.xml"/>
    <add key="PTS_TAD" value="C:\temp\M.Settings\MGDT_TAD.xml"/>
    <!-- icd item 저장 -->
    <add key="FIELD_SETTING_FOLDER" value="C:\temp\M.Settings\fieldSettings\" />
  </appSettings>
</configuration>