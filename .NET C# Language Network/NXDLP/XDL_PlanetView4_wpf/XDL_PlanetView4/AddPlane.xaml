<Window x:Class="XDL_PlanetView4.AddPlane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDL_PlanetView4"
        mc:Ignorable="d"
        Title="Add Plane" Height="330" Width="500" Background="LightGray" Icon="pixonnerimage1_qCH_icon.ico" MinWidth="350" MinHeight="320">
    <Viewbox>
        <Grid Height="251" Width="368">
        <TextBox x:Name="textBoxID" HorizontalAlignment="Left" Height="23" Margin="72,41,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="165"/>
            <TextBox x:Name="textBoxName" HorizontalAlignment="Left" Height="23" Margin="72,69,30,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="165"/>
            <Label x:Name="label1" Content="ID :" HorizontalAlignment="Left" Margin="38,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.19,-0.109"/>
            <Label x:Name="label2" Content="Name :" HorizontalAlignment="Left" Margin="18,62,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.131,0.306"/>
            <TextBox x:Name="textBoxPathModel" HorizontalAlignment="Left" Height="23" Margin="72,108,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="221"/>
            <TextBox x:Name="textBoxPathData" HorizontalAlignment="Left" Height="23" Margin="72,136,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="221"/>
            <Button x:Name="buttonLoadModel" Content="..." HorizontalAlignment="Left" Margin="298,108,0,0" VerticalAlignment="Top" Width="42" Height="23" Click="buttonLoadModel_Click"/>
            <Button x:Name="buttonLoadData" Content="..." HorizontalAlignment="Left" Margin="298,136,0,0" VerticalAlignment="Top" Width="42" Height="23" Click="buttonLoadData_Click"/>
            <Label x:Name="label3" Content="Model :" HorizontalAlignment="Left" Margin="15,102,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.095,0.515"/>
            <Label x:Name="label4" Content="Data :" HorizontalAlignment="Left" Margin="25,133,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.325,0.459"/>
            <Button x:Name="buttonOK" HorizontalAlignment="Left" Margin="54,191,0,0" VerticalAlignment="Top" Width="75" Click="buttonOK_Click">OK</Button>
            <Button x:Name="buttonCancel" HorizontalAlignment="Left" Margin="143,191,54,0" VerticalAlignment="Top" Width="75" Click="buttonCancel_Click" IsDefault="True">Cancel</Button>
        </Grid>
    </Viewbox>
</Window>
