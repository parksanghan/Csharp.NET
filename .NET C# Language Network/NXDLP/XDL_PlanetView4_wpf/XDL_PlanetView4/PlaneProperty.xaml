<Window x:Class="XDL_PlanetView4.PlaneProperty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDL_PlanetView4"
        mc:Ignorable="d"
        Title="PlaneProperty" Height="420" Width="240" Background="LightGray"  Loaded="Window_Loaded" MinWidth="240" MinHeight="430" Icon="pixonnerimage1_qCH_icon.ico">
    <Viewbox>
        <Grid Height="421">
            <TextBox x:Name="textBoxID" HorizontalAlignment="Left" Height="23" Margin="82,26,40,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="125" IsReadOnly="True"/>
            <TextBox x:Name="textBoxName" HorizontalAlignment="Left" Height="23" Margin="82,54,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="125"/>
            <Label x:Name="label1" Content="ID :" HorizontalAlignment="Left" Margin="43,23,0,0" VerticalAlignment="Top"/>
            <Label x:Name="label2" Content="Name :" HorizontalAlignment="Left" Margin="28,51,0,0" VerticalAlignment="Top"/>
            <GroupBox x:Name="groupBox" Header="Scale" HorizontalAlignment="Left" Margin="19,100,0,0" VerticalAlignment="Top" Height="155" Width="211">
                <Grid>
                    <Label Content="X : " HorizontalAlignment="Left" Margin="21,11,0,0" VerticalAlignment="Top"/>
                    <Label Content="Y : " HorizontalAlignment="Left" Margin="21,40,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.477,1.89"/>
                    <Label Content="Z : " HorizontalAlignment="Left" Margin="21,69,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.477,1.89"/>
                    <TextBox x:Name="textBoxScaleX" HorizontalAlignment="Left" Height="23" Margin="55,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
                    <TextBox x:Name="textBoxScaleY" HorizontalAlignment="Left" Height="23" Margin="55,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
                    <TextBox x:Name="textBoxScaleZ" HorizontalAlignment="Left" Height="23" Margin="55,72,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
                    <CheckBox x:Name="checkBoxScalable" Content="Scalable" HorizontalAlignment="Left" Margin="66,107,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.12,0.702"/>
                </Grid>
            </GroupBox>
            <Label Content="Mode :" HorizontalAlignment="Left" Margin="30,268,0,0" VerticalAlignment="Top"/>
            <ComboBox x:Name="comboBoxCameraMode" HorizontalAlignment="Left" Margin="87,272,0,0" VerticalAlignment="Top" Width="122">
                <ComboBoxItem Content="Back View"/>
                <ComboBoxItem Content="Front View"/>
                <ComboBoxItem Content="Left View"/>
                <ComboBoxItem Content="Right View"/>
                <ComboBoxItem Content="God's eye View"/>
                <ComboBoxItem Content="God's eye View Static"/>
                <ComboBoxItem Content="Bottom View"/>
                <ComboBoxItem Content="Bottom View Static"/>
                <ComboBoxItem Content="Inside View"/>
                <ComboBoxItem Content="Inside View free"/>
                <ComboBoxItem Content="Far View"/>
                <ComboBoxItem Content="Unusable"/>
            </ComboBox>
            <CheckBox x:Name="checkBoxShowBoundingBox" Content="Show Bounding Box" HorizontalAlignment="Left" Margin="56,309,0,0" VerticalAlignment="Top"/>
            <Button x:Name="buttonOK" HorizontalAlignment="Left" Margin="38,346,0,0" VerticalAlignment="Top" Width="75" Click="buttonOK_Click">OK</Button>
            <Button x:Name="buttonCancel" HorizontalAlignment="Left" Margin="127,346,0,0" VerticalAlignment="Top" Width="75" Click="buttonCancel_Click">Cancel</Button>
        </Grid>
    </Viewbox>
</Window>
