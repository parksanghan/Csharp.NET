<ui:FluentWindow x:Class="DataGenerator.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Packet ICD Code Generator"
                 Width="1180"
                 Height="780"
                 MinWidth="980"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Packet ICD Code Generator" />

        <Grid Grid.Row="1"
              Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    CornerRadius="12"
                    Background="#D91F1F1F"
                    BorderBrush="#404040"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="생성 입력" />

                    <TextBlock Grid.Row="1"
                               Margin="0,22,0,7"
                               FontWeight="SemiBold"
                               Text="패킷 정의 XML" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="XmlPathTextBox"
                                 Grid.Column="0"
                                 Height="38"
                                 Padding="10,6"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 ToolTip="PacketDefinitions.xml 파일을 선택하세요." />

                        <ui:Button Grid.Column="2"
                                   MinWidth="102"
                                   Padding="14,7"
                                   Click="BrowseXmlButton_Click"
                                   Content="파일 찾기" />
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <TextBlock Margin="0,20,0,7"
                                   FontWeight="SemiBold"
                                   Text="대상 솔루션 또는 C# 프로젝트" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TargetPathTextBox"
                                     Grid.Column="0"
                                     Height="38"
                                     Padding="10,6"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     ToolTip=".sln 또는 .csproj 파일을 선택하세요." />

                            <ui:Button Grid.Column="2"
                                       MinWidth="102"
                                       Padding="14,7"
                                       Click="BrowseTargetButton_Click"
                                       Content="파일 찾기" />
                        </Grid>

                        <TextBlock Margin="0,16,0,7"
                                   FontWeight="SemiBold"
                                   Text="코드를 생성할 프로젝트" />

                        <ComboBox x:Name="TargetProjectComboBox"
                                  Height="38"
                                  Padding="8,5"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="TargetProjectComboBox_SelectionChanged" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Margin="0,22,0,0"
                            Padding="16"
                            CornerRadius="8"
                            Background="#70111111"
                            BorderBrush="#353535"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="생성 위치" />
                            <TextBlock Margin="0,9,0,0"
                                       Opacity="0.82"
                                       Text="MessageStructs\MessageModels.cs"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Opacity="0.82"
                                       Text="Packets\{PacketName}.cs"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Opacity="0.82"
                                       Text="Lib\NetworkGenerator.dll + .csproj 참조"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    CornerRadius="12"
                    Background="#D91F1F1F"
                    BorderBrush="#404040"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="XML 패킷 미리보기" />

                    <TextBlock x:Name="XmlSummaryTextBlock"
                               Grid.Row="1"
                               Margin="0,8,0,12"
                               Opacity="0.72"
                               Text="XML 파일을 선택하면 패킷 정의가 표시됩니다." />

                    <DataGrid x:Name="PacketPreviewGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              MouseDoubleClick="PacketPreviewGrid_MouseDoubleClick"
                              ToolTip="패킷 행을 더블클릭하면 필드 정보를 볼 수 있습니다.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="Packet"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn Width="*"
                                                Header="Message ID"
                                                Binding="{Binding MessageId}" />
                            <DataGridTextColumn Width="78"
                                                Header="Sync"
                                                Binding="{Binding Sync}" />
                            <DataGridTextColumn Width="*"
                                                Header="Data Type"
                                                Binding="{Binding DataType}" />
                            <DataGridTextColumn Width="58"
                                                Header="Fields"
                                                Binding="{Binding FieldCount}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                               Margin="0,18,0,8"
                               FontWeight="SemiBold"
                               Text="실행 로그" />

                    <TextBox x:Name="LogTextBox"
                             Grid.Row="4"
                             Padding="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="대기 중" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="#E6161616"
                BorderBrush="#353535"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               FontWeight="SemiBold"
                               Text="XML과 대상 프로젝트를 선택하세요." />
                    <TextBlock x:Name="RuntimePathTextBlock"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Opacity="0.62" />
                </StackPanel>

                <ui:Button x:Name="GenerateButton"
                           Grid.Column="1"
                           MinWidth="170"
                           Height="48"
                           Padding="22,9"
                           Appearance="Primary"
                           Click="GenerateButton_Click"
                           Content="▶  코드 생성" />
            </Grid>
        </Border>

        <Grid x:Name="XmlLoadingOverlay"
              Grid.Row="1"
              Grid.RowSpan="2"
              Panel.ZIndex="100"
              Background="#B0000000"
              Visibility="Collapsed">
            <Border Width="520"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="#F5222222"
                    BorderBrush="#505050"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="XML 패킷 분석 중" />

                        <TextBlock x:Name="XmlParsePercentTextBlock"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#27DFF0"
                                   Text="준비 중" />
                    </Grid>

                    <TextBlock x:Name="XmlParseStatusTextBlock"
                               Margin="0,14,0,0"
                               FontSize="14"
                               Text="XML 파일을 준비하는 중입니다."
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="XmlParseDetailTextBlock"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Opacity="0.68"
                               Text="파일 정보를 확인하고 있습니다."
                               TextWrapping="Wrap" />

                    <ProgressBar x:Name="XmlParseProgressBar"
                                 Margin="0,18,0,0"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="True"
                                 Foreground="#27DFF0" />

                    <ui:Button x:Name="CancelXmlLoadingButton"
                               Margin="0,20,0,0"
                               MinWidth="110"
                               Padding="18,8"
                               HorizontalAlignment="Right"
                               Click="CancelXmlLoadingButton_Click"
                               Content="분석 취소" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
