<ui:FluentWindow x:Class="DataGenerator.PacketFieldDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="패킷 필드 정보"
                 Width="980"
                 Height="620"
                 MinWidth="820"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="패킷 필드 정보" />

        <Border x:Name="EditModeInfoBorder"
                Grid.Row="1"
                Margin="24,16,24,0"
                Padding="14,10"
                CornerRadius="8"
                Background="#4032D7E8"
                BorderBrush="#8032D7E8"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock Text="수정 모드 · 값을 변경한 뒤 저장을 누르면 원본 XML 파일에 반영됩니다."
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Margin="24,18,24,14"
                Padding="18"
                CornerRadius="10"
                Background="#D91F1F1F"
                BorderBrush="#404040"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0">
                    <TextBlock Opacity="0.65"
                               Text="Packet" />
                    <TextBox x:Name="PacketNameTextBox"
                             Margin="0,4,12,0"
                             Height="34"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1">
                    <TextBlock Opacity="0.65"
                               Text="Message ID" />
                    <TextBox x:Name="MessageIdTextBox"
                             Margin="0,4,12,0"
                             Height="34"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="2">
                    <TextBlock Opacity="0.65"
                               Text="Message ID Value" />
                    <TextBox x:Name="MessageIdValueTextBox"
                             Margin="0,4,0,0"
                             Height="34"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,16,0,0">
                    <TextBlock Opacity="0.65"
                               Text="Sync" />
                    <TextBox x:Name="SyncTextBox"
                             Margin="0,4,12,0"
                             Height="34"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0">
                    <TextBlock Opacity="0.65"
                               Text="Data Type" />
                    <TextBox x:Name="DataTypeTextBox"
                             Margin="0,4,0,0"
                             Height="34"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="24,0,24,0"
                Padding="18"
                CornerRadius="10"
                Background="#D91F1F1F"
                BorderBrush="#404040"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="FieldCountTextBlock"
                           Grid.Row="0"
                           Margin="0,0,0,12"
                           FontSize="17"
                           FontWeight="SemiBold" />

                <DataGrid x:Name="FieldGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="70"
                                            Header="Order"
                                            Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Width="2*"
                                            Header="Field"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Width="*"
                                            Header="Type"
                                            Binding="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Width="*"
                                            Header="Resolution"
                                            Binding="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Width="*"
                                            Header="Min"
                                            Binding="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Width="*"
                                            Header="Max"
                                            Binding="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4"
              Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SaveStatusTextBlock"
                           Opacity="0.72"
                           Text="조회 모드" />
                <ProgressBar x:Name="SaveProgressBar"
                             Margin="0,7,24,0"
                             Height="5"
                             IsIndeterminate="True"
                             Foreground="#27DFF0"
                             Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <ui:Button x:Name="CloseButton"
                           MinWidth="100"
                           Padding="18,8"
                           Click="CloseButton_Click"
                           Content="닫기" />

                <ui:Button x:Name="EditButton"
                           Margin="10,0,0,0"
                           MinWidth="110"
                           Padding="18,8"
                           Appearance="Primary"
                           Click="EditButton_Click"
                           Content="수정" />

                <ui:Button x:Name="CancelEditButton"
                           MinWidth="100"
                           Padding="18,8"
                           Click="CancelEditButton_Click"
                           Content="취소"
                           Visibility="Collapsed" />

                <ui:Button x:Name="SaveButton"
                           Margin="10,0,0,0"
                           MinWidth="110"
                           Padding="18,8"
                           Appearance="Primary"
                           Click="SaveButton_Click"
                           Content="저장"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
