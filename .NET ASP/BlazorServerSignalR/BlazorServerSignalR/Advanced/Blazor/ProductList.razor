@using BlazorServerSignalR.Models
@using Microsoft.EntityFrameworkCore
<table class="table table-sm table-bordered table-striped">
	<thead>
		<tr>
			<th>ID</th>
			<th>Name (Price)</th>
			<th>Category</th>
			<th>Manufacturer</th>
		</tr>
	</thead>
	<tbody>
		@foreach (Product p in Product ?? Enumerable.Empty<Product>())
		{
			<tr class="@GetClass(p.ProductManufacturer?.ManufacturerName)">
				<td class="@GetClass(p.ProductManufacturer?.ManufacturerName)">@p.ProductId</td>
				<td class="@GetClass(p.ProductManufacturer?.ManufacturerName)">@p.ProductName, @p.ProductPrice?.ToString("#,##0")</td>
				<td> class="@GetClass(p.ProductManufacturer?.ManufacturerName)"@p.ProductCategory.CategoryName</td>
				<td class="@GetClass(p.ProductManufacturer?.ManufacturerName)">@p.ProductManufacturer?.ManufacturerName</td>
			</tr>
		}
	</tbody>
</table>

<form asp-action="Index" method="get">
	<div class="form-group">
		<label for="selectedManufacturer">Manufacturer</label>
		<select name="selectedManufacturer" class="form-control" @bind="SelectedManufacturer">
			<option disabled selected>Select Manufacturer</option>
			@foreach (string Manufacturer in Manufacturer ?? Enumerable.Empty<string>())
			{
				<option value="@Manufacturer" selected="@(Manufacturer == SelectedManufacturer)">
					@Manufacturer
				</option>
			}
		</select>
		@*위와 아래는 같은코드*@

		<SelectedFilter title="Manufacturer" values="@Manufacturer" autofocus="true" name="Manufacturer" required ="true" CustomEvent="">

		</SelectedFilter>
	</div>
	<button class="btn btn-primary mt-2" type="submit">Select</button>
</form>

@code {
	[Inject]
	// 이런식으로 생성자 주입함
	public BlazorTDBContext? Context { get; set; }

	public IEnumerable<Product>? Product => Context?.Products.Include(p => p.ProductCategory).Include(p => p.ProductManufacturer);
	public IEnumerable<string>? Manufacturer => Context?.Manufacturers.Select(m => m.ManufacturerName);
	public string SelectedManufacturer { get; set; } = string.Empty;
	public string GetClass(string? Manufacturer) => SelectedManufacturer == Manufacturer ? "bg-info text-white" : "";
	[Parameter]
	public int ItemCount {get;set;}=4;
	[Parameter]
	public string? SelectTitle  { get; set; }
	public void handleCustom(string value)
	{
		SelectedManufacturer = value;	
	}
}