<h3>Reset</h3>
<form action="/pages/blazor" method="get">
    @for (int i = 0; i < ElementCount; i++)
    {
        int temp = i;
        <div class="m-2 p-2 border">
            <button class="btn btn-primary" @onclick="@(()=>IncrementCounter(temp))" @onclick:preventDefault="EnableEventArgsParams">
                Increment Counter #@(i + 1) EnableEventParams 값 : #@(EnableEventArgsParams)</button>
            <button class="btn btn-primary" @onclick="@(()=>Counters.Remove(temp))">
                 Reset Button
             </button>
             <span class="p-2">Counter Value @GetCounter(i)</span>
        </div>
    }
</form>
<div class="m-2" @onclick="@(()=>IncrementCounter(1))">
    <button class="btn btn-primary" @onclick="@(()=>IncrementCounter(0))" @onclick:stopPropagation="EnableEventArgsParams"> 
        Propagation Button
    </button>
</div>
<div class="form-check m-2">
    <input class="form-check-input" @onchange="@(()=>EnableEventArgsParams= !EnableEventArgsParams)"/>
    <label class="form-check-label" >Enable Event Parameters</label>

</div>
@code {
    public int ElementCount { get; set; } = 4;
    public Dictionary<int, int> Counters { get; } = new Dictionary<int, int>();

    public int GetCounter(int idx) => Counters.ContainsKey(idx) ? Counters[idx] : 0;
    public void IncrementCounter(int idx) => Counters[idx] = GetCounter(idx) + 1;
    public bool EnableEventArgsParams { get; set; } = false;
}
