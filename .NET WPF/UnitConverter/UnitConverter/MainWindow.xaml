<Window x:Class="UnitConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnitConverter"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Left" Margin="24,10,0,0" Orientation="Horizontal" VerticalAlignment="Top" Height="49" Width="766">
            <Label Content="단위계 변환" RenderTransformOrigin="0.456,0.139"/>
            <RadioButton Content="Km/s" Height="17" Width="96" GroupName="Speed"/>
            <RadioButton Content="m/s" Height="17" Width="96" GroupName="Speed"/>
            <RadioButton Content="Kn" Height="17" Width="96" GroupName="Speed"/>
            <RadioButton Content="mach" Height="17" Width="96" GroupName="Speed"/>
            <TextBox TextWrapping="Wrap" Text="TextBox" Width="104" Height="21" TextAlignment="Center" VerticalAlignment="Center" />
            <TextBox TextWrapping="Wrap" Text="TextBox" Width="104" Height="21" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="Convert" Width="83" Height="25" />

        </StackPanel>

    </Grid>
</Window>
