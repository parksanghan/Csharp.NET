<UserControl x:Class="DXApplication4.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:DXApplication4.ViewModels"
             xmlns:infr="clr-namespace:DXApplication4.Infrastructure">

    <UserControl.DataContext>
        <infr:DISource Type="{x:Type vm:UsersViewModel}"/>
    </UserControl.DataContext>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding LoadAsyncCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <dxg:GridControl ItemsSource="{Binding Users}"
                   SelectedItem="{Binding Selected}"
                   ShowLoadingPanel="{Binding IsBusy}">
        <dxg:GridControl.View>
            <dxg:TableView ShowGroupPanel="False"
                     ShowSearchPanelMode="Always"
                     AutoWidth="True"/>
        </dxg:GridControl.View>

        <dxg:GridColumn FieldName="User_Id" Header="ID" ReadOnly="True" Width="80"/>
        <dxg:GridColumn FieldName="Username" Header="Username" Width="240"/>
        <dxg:GridColumn FieldName="Password" Header="Password" Width="240"/>
    </dxg:GridControl>
</UserControl>
