<!-- Views/ChatLogsView.xaml -->
<UserControl x:Class="DXApplication4.Views.ChatLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:DXApplication4.ViewModels"
             xmlns:infr="clr-namespace:DXApplication4.Infrastructure">

    <!-- DI 주입 -->
    <UserControl.DataContext>
        <infr:DISource Type="{x:Type vm:ChatLogsViewModel}"/>
    </UserControl.DataContext>

    <!-- 로드시 초기 조회 -->
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding InitializeAsyncCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 필터 바 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <ComboBox Width="220"
                      ItemsSource="{Binding UsersForFilter}"
                      SelectedValuePath="User_Id"
                      DisplayMemberPath="Username"
                      SelectedValue="{Binding SelectedUserId}"/>
            <ComboBox Width="180" Margin="8,0,0,0"
                      ItemsSource="{Binding LogTypes}"
                      SelectedItem="{Binding SelectedLogType}"/>
            <DatePicker Width="160" Margin="8,0,0,0" SelectedDate="{Binding From}"/>
            <DatePicker Width="160" Margin="8,0,0,0" SelectedDate="{Binding To}"/>
            <Button Content="적용"   Margin="8,0,0,0" Command="{Binding ApplyAsyncCommand}"/>
            <Button Content="초기화" Margin="8,0,0,0" Command="{Binding ResetAsyncCommand}"/>
        </StackPanel>

        <!-- 로그 그리드 -->
        <dxg:GridControl Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         ShowLoadingPanel="{Binding IsBusy}">
            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="False"
                               ShowSearchPanelMode="Always"
                               AutoWidth="True"/>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Chat_Id" Header="ChatId" Width="80" ReadOnly="True"/>
            <dxg:GridColumn FieldName="Username" Header="Username" Width="180"/>
            <dxg:GridColumn FieldName="Log_Type" Header="LogType" Width="120"/>

            <!-- Timestamp 포맷 -->
            <dxg:GridColumn FieldName="Timestamp" Header="Timestamp" Width="170">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="Message_Preview"  Header="Message (preview)"  Width="350"/>
            <dxg:GridColumn FieldName="Response_Preview" Header="Response (preview)" Width="350"/>

            <!-- 행 별 삭제 버튼 -->
            <dxg:GridColumn Header="Ops" Width="100" AllowEditing="False">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <Button Content="Delete"
                                Command="{Binding DataContext.DeleteAsyncCommand, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>
        </dxg:GridControl>
    </Grid>
</UserControl>
