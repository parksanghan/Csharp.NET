<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<PackageReference Include="Dapper" Version="2.1.66" />

	 
		<PackageReference Include="DevExpress.Wpf" Version="25.1.*" />
		<PackageReference Include="DevExpress.Mvvm.CodeGenerators" Version="22.1.1" />
		<PackageReference Include="DevExpress.Mvvm" Version="25.1.*" />
		<PackageReference Include="DevExpress.Wpf.Core" Version="25.1.4" />
		<PackageReference Include="DevExpress.Wpf.Grid" Version="25.1.4" />
		<PackageReference Include="DevExpress.Wpf.Themes.Office2019Colorful" Version="25.1.4" />
		<PackageReference Include="DevExpress.Wpf.ThemesLW" Version="25.1.*" />

	 
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />

	 
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
	</ItemGroup>
</Project>
