<Window x:Class="WpfComObjectSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WPF COM Object Sample" Height="520" Width="860"
        MinHeight="460" MinWidth="720"
        FontFamily="Segoe UI" Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="WPF에서 COM 객체 사용"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="COM ProgID" FontWeight="SemiBold" />
                <TextBox x:Name="ProgIdTextBox" Text="Scripting.Dictionary" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" FontWeight="SemiBold" />
                <Border Background="White"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        MinHeight="32"
                        Margin="0,4,0,12">
                    <TextBlock x:Name="StatusTextBlock" Text="COM object is not created." />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Key" FontWeight="SemiBold" />
                <TextBox x:Name="KeyTextBox" Text="name" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="Value" FontWeight="SemiBold" />
                <TextBox x:Name="ValueTextBox" Text="COM from WPF" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12">
                <Button Content="Create" Click="CreateComObjectButton_Click" />
                <Button Content="Add" Click="AddValueButton_Click" />
                <Button Content="Read" Click="ReadValueButton_Click" />
                <Button Content="Clear" Click="ClearButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Log" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1"
                     x:Name="LogTextBox"
                     FontFamily="Consolas"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</Window>
