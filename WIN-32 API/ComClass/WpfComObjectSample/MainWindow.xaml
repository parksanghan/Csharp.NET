<Window x:Class="WpfComObjectSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:graphing="clr-namespace:WpfComObjectSample.Graphing"
        mc:Ignorable="d"
        Title="Graph Drawer" Height="620" Width="980"
        MinHeight="520" MinWidth="760"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ObjectDataProvider x:Key="GraphFunctionValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="graphing:GraphFunction" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="0,0,1,0"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Graph Drawer"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,22" />

                <TextBlock Text="Function" FontWeight="SemiBold" />
                <ComboBox x:Name="FunctionComboBox"
                          ItemsSource="{Binding Source={StaticResource GraphFunctionValues}}"
                          SelectedIndex="0"
                          Margin="0,4,0,16"
                          SelectionChanged="GraphInput_Changed" />

                <TextBlock Text="Amplitude" FontWeight="SemiBold" />
                <Slider x:Name="AmplitudeSlider"
                        Minimum="0.5"
                        Maximum="5"
                        Value="1"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="GraphInput_Changed" />
                <TextBlock x:Name="AmplitudeTextBlock" Margin="0,0,0,12" />

                <TextBlock Text="Frequency" FontWeight="SemiBold" />
                <Slider x:Name="FrequencySlider"
                        Minimum="0.5"
                        Maximum="5"
                        Value="1"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        ValueChanged="GraphInput_Changed" />
                <TextBlock x:Name="FrequencyTextBlock" Margin="0,0,0,12" />

                <TextBlock Text="Range" FontWeight="SemiBold" />
                <Slider x:Name="RangeSlider"
                        Minimum="4"
                        Maximum="20"
                        Value="12"
                        TickFrequency="2"
                        IsSnapToTickEnabled="True"
                        ValueChanged="GraphInput_Changed" />
                <TextBlock x:Name="RangeTextBlock" Margin="0,0,0,20" />

                <Button Content="Redraw" Click="RedrawButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Border Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Canvas x:Name="GraphCanvas"
                        Background="White"
                        SizeChanged="GraphCanvas_SizeChanged" />
            </Border>
        </Grid>
    </Grid>
</Window>
